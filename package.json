{
  "name": "darb-takehome",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/ensure-env.mjs && jest --runInBand",
    "test:watch": "jest --watch",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/ensure-env.mjs && rm -f prisma/dev.db && prisma db push --skip-generate && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/ensure-env.mjs && prisma generate",
    "setup": "prisma generate && npm run db:reset",
    "webhooks:demo": "bash scripts/send-sample-webhooks.sh",
    "payloads:generate": "tsx scripts/generate-payloads.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "next": "15.5.27",
    "next-safe-action": "^8.7.3",
    "radix-ui": "^1.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
