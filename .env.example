# SQLite — no server required for this exercise.
DATABASE_URL="file:./dev.db"

# Webhook HMAC shared secrets. In production these come from the provider console
# and live in a secret manager, never in the repo.
EMAIL_WEBHOOK_SECRET="<your-secret>"
WHATSAPP_WEBHOOK_SECRET="<your-secret>"

# Set to "false" to require valid signatures.
# Default permissive outside production so the sample curl scripts work without signing.
# In production this variable is ignored and unsigned requests are always refused.
ALLOW_UNSIGNED_WEBHOOKS="true"
