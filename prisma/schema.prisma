// Darb Portal — document ingestion & transaction matching.
//
// NOTE ON SQLITE AND ENUMS
// The exercise brief models DocumentSource / DocumentStatus / MatchStatus as Prisma
// `enum`s and `DocumentMatch.signals` as `Json`. Neither is supported by Prisma's
// SQLite connector, so both are stored as `String` here. Type safety is preserved at
// the application boundary instead: see `lib/domain/enums.ts` for the union types and
// Zod schemas that every read and write passes through. The column type is the only
// thing that changed — the domain model is unchanged, and switching the datasource to
// Postgres would let these become real enums with no application-code edits.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A Darb customer (a fleet). Scopes which transactions an emailed invoice may match.
model Client {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  transactions     Transaction[]
  senderIdentities SenderIdentity[]
}

/// Maps an inbound sender (email address or E.164 phone) to the scope it is allowed
/// to submit documents for.
///
/// The brief's schema carries `clientId` and `driverPhone` on Transaction but gives no
/// way to resolve an *email* sender to a client, which makes the "an email document may
/// only match that client's transactions" rule unimplementable. This model is the
/// missing link and is the one schema extension that is not optional.
model SenderIdentity {
  id          Int      @id @default(autoincrement())
  /// Lowercased email address, or E.164 phone number without a leading '+'.
  identifier  String   @unique
  /// 'EMAIL' | 'WHATSAPP' — see lib/domain/enums.ts
  channel     String
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  /// Set for driver (WhatsApp) identities. Null for a fleet-manager mailbox, which is
  /// scoped to the whole client rather than to one driver's cards.
  driverPhone String?
  /// Human label for the review queue ("Faisal Al-Harbi", "Fleet Manager inbox").
  label       String
  createdAt   DateTime @default(now())

  @@index([clientId])
}

model Transaction {
  id            Int      @id @default(autoincrement())
  clientId      Int
  client        Client   @relation(fields: [clientId], references: [id])
  cardLast4     String
  /// E.164 without '+'. Used to scope WhatsApp documents to the driver holding the card.
  driverPhone   String?
  /// Acquirer-provided name — noisy by nature ("ALFANAR FUEL ST 04 RUH").
  merchantName  String
  /// Minor units (halalas). Integer: never float money.
  amount        Int
  currency      String   @default("SAR")
  transactionAt DateTime

  /// Enforces "one confirmed document per transaction" IN THE DATABASE rather than in
  /// application logic. A second confirm attempt violates this unique constraint and
  /// fails loudly (P2002) even under concurrent double-submit.
  confirmedDocumentId Int?      @unique
  confirmedDocument   Document? @relation("ConfirmedDocument", fields: [confirmedDocumentId], references: [id])

  /// Named `documents` to match the brief's schema. It holds DocumentMatch rows — the
  /// candidate pairings for this transaction, not Document rows directly.
  documents DocumentMatch[]

  /// DOCUMENTED | IN_REVIEW | REJECTED | MISSING — a cache of `documentationStatusOf`.
  ///
  /// The derivation reads `confirmedDocumentId` plus every match on the charge, which is
  /// correct and unindexable: a status computed in Node cannot appear in a WHERE or a
  /// COUNT, so the register had to load every charge *and its matches* just to filter or
  /// tally them. Storing it turns those into indexed queries.
  ///
  /// `documentationStatusOf` remains the definition of truth. This column is only ever
  /// written by `recomputeDocumentationStatus`, which calls that function — the rule is
  /// not duplicated — and `expectStatusesConsistent` re-derives every row in the test
  /// suite to prove the two cannot diverge.
  documentationStatus String @default("MISSING")

  @@index([clientId, transactionAt])
  @@index([driverPhone, transactionAt])
  @@index([clientId, documentationStatus])
  @@index([clientId, documentationStatus, transactionAt])
}

model Document {
  id               Int     @id @default(autoincrement())
  /// 'EMAIL' | 'WHATSAPP'
  source           String
  /// Provider message id — messageId for email, wamid for WhatsApp.
  externalId       String  @unique
  /// SHA-256 of the file bytes. Unique, per the brief: the same file content must never
  /// create a second Document, whoever sent it.
  contentHash      String  @unique
  /// Email address or phone that sent it. Resolves to a SenderIdentity.
  senderIdentifier String
  /// Resolved scope, denormalised at ingestion so matching needs no extra joins.
  clientId         Int?
  driverPhone      String?
  /// RECEIVED | EXTRACTED | MATCHED | NEEDS_REVIEW | UNMATCHED | FAILED
  status           String  @default("RECEIVED")
  /// Set when status is FAILED — why extraction or ingestion gave up.
  failureReason    String?

  // ---- Extraction results (null until extracted) ----
  documentType         String?
  merchantName         String?
  vatNumber            String?
  totalAmount          Int?
  currency             String?
  documentDate         DateTime?
  cardLast4            String?
  invoiceNumber        String?
  rawText              String?
  extractionConfidence Float?

  filename   String?
  mimeType   String?
  receivedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  matches                 DocumentMatch[]
  confirmedForTransaction Transaction?    @relation("ConfirmedDocument")

  @@index([status])
  /// Both registers read documents the same way: narrow to one client, filter on status,
  /// and order by arrival. `@@index([status])` alone left the client filter and the sort
  /// uncovered, so every page of the document register and every pass of the work queue
  /// paid for a filesort. The charge side already had four composite indexes tuned to its
  /// register; this is the document side catching up.
  @@index([clientId, status, receivedAt])
}

model DocumentMatch {
  id            Int         @id @default(autoincrement())
  documentId    Int
  transactionId Int
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  confidence    Float
  /// JSON-encoded Record<string, number> — the per-signal breakdown that makes a score
  /// explainable to a reviewer. Stored as String because SQLite has no Json type;
  /// read and written through the codecs in lib/domain/enums.ts.
  signals       String
  /// CANDIDATE | AUTO_CONFIRMED | CONFIRMED | REJECTED
  status        String      @default("CANDIDATE")
  /// 'system' or a reviewer identifier.
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())

  /// --- Maker-checker ------------------------------------------------------------
  /// Six columns. Five are nullable and `verificationRequired` defaults to false, so a
  /// deployment with the control switched off behaves exactly as it did before these
  /// columns existed — the inertness rests on that default, not on nullability.

  /// Whether this attachment was selected for independent sign-off. Decided once, when
  /// the attachment is made, rather than evaluated at read time: a sampling rule that is
  /// re-rolled on every page load would let a reviewer refresh until the work disappears,
  /// and a materiality threshold that changed later would silently rewrite history.
  verificationRequired Boolean   @default(false)
  /// Who signed it off. Must differ from `decidedBy` — that difference is the control.
  verifiedBy           String?
  verifiedAt           DateTime?
  /// UPHELD | OVERTURNED. Null while it is still waiting.
  verificationOutcome  String?
  /// MATERIAL | AUTOMATIC | SAMPLED — why this was selected. Persisted rather than
  /// recomputed, because the policy that selected it can change afterwards and a checker
  /// reading "sampled" on something chosen for its value would misjudge how carefully to
  /// look.
  verificationTrigger  String?
  /// The sentence shown to the checker, snapshotted for the same reason.
  verificationReason   String?

  @@unique([documentId, transactionId])
  @@index([documentId, confidence])
  @@index([transactionId])
}

/// Append-only record of every decision taken about a document.
///
/// The `decidedBy` / `decidedAt` columns on DocumentMatch hold the *current* decision and
/// are overwritten when it changes, so they cannot answer the question an auditor actually
/// asks — not "who owns this now" but "show me everything that happened to this receipt,
/// in order, eighteen months later". A receipt that was auto-matched, rejected by one
/// person, re-attached by another and signed off by a third has one row in DocumentMatch
/// and four events here.
///
/// Nothing updates or deletes a row in this table. SQLite cannot express append-only, so
/// that is a property of the code: `recordEvent` is the only write path — and of the
/// schema, in that no relation can cascade a delete into it.
model ReviewEvent {
  id Int @id @default(autoincrement())

  /// The document involved. Deliberately **not** a foreign key, for the same reason as
  /// `transactionId` below — and this column used to be one, with `onDelete: Cascade`,
  /// which meant deleting a document silently destroyed its entire history. A trail that
  /// disappears with the thing it describes is not an audit trail, and the contradiction
  /// sat two lines from the paragraph arguing the opposite case for the charge.
  documentId Int

  /// The charge involved, when the event concerns one. Deliberately not a foreign key: a
  /// charge may be purged under a retention policy long after the audit trail must still
  /// read sensibly, and an event that vanishes with its transaction defeats the point.
  transactionId Int?
  /// The match row involved. Null for document-level events.
  matchId       Int?

  /// AUTO_MATCHED | CONFIRMED | REJECTED | VERIFIED | OVERTURNED
  action     String
  /// Actor id from the host identity, or 'system'.
  actorId    String
  /// SYSTEM | MAKER | CHECKER — which hat the actor was wearing.
  actorRole  String
  /// Confidence at the moment of the decision. Snapshotted because re-running the matcher
  /// later can produce a different number, and the trail must show what the person was
  /// actually looking at.
  confidence Float?
  /// Free text: an overturn reason, or a checker's note.
  note       String?

  createdAt DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([transactionId])
  @@index([actorId, createdAt])
}

/// Idempotency record for transaction-batch ingestion.
///
/// `POST /api/transactions` creates financial resources, which the org standard says must
/// accept an `Idempotency-Key`. It is also the endpoint whose response the caller is most
/// likely to miss — the re-match sweep runs before it answers — so a timeout followed by a
/// retry is the expected case, not an exotic one. Without this, that retry silently
/// doubles the charges, and two identical same-day same-merchant transactions is the
/// system's own definition of an ambiguous match: the duplicate manufactures review work.
///
/// The key is stored with the caller's scope prefixed, so two callers cannot collide on a
/// well-meaning value like "batch-1".
model TransactionBatch {
  id             Int      @id @default(autoincrement())
  /// `{callerId}:{idempotencyKey}`.
  idempotencyKey String   @unique
  /// JSON array of the transaction ids this batch created, so a replay can answer with
  /// the original result rather than an empty one.
  transactionIds String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
